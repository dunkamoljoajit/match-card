n+" "+this.props.type]}get h8b54e37(){return["สร้าง "]}get ca584c31(){return["มีบริษัทที่มีเว็บไซต์นี้อยู่แล้ว คุณหมายถึง "," หรือไม่"]}get eb96a831(){return["ตัวกรองเหล่านี้จะไม่มีผลต่อการแจ้งเตือนจากคนที่คุณติดตาม "]}get aba5a349(){return["คุณสามารถซ่อนได้หนึ่งคำ วลี @ชื่อผู้ใช้ หรือแฮชแท็กต่อครั้ง "]}get f03ea36d(){return["เมื่อคุณซ่อนคำ คุณจะไม่ได้รับการแจ้งเตือนใหม่ๆ สำหรับโพสต์ที่มีคำเหล่านั้น หรือเห็นโพสต์ที่มีคำเหล่านั้นในลำดับเหตุการณ์ในหน้าแรกของคุณ "]}get b0b13519(){return["นี่คือทุกบัญชีที่คุณซ่อนไว้ คุณสามารถเพิ่มหรือลบพวกเขาออกจากรายชื่อนี้ได้ "]}get e212a9ab(){return["จัดการการตั้งค่าของคุณสำหรับการดูสื่อที่มีเนื้อหาล่อแหลมบน X เรียนรู้เพิ่มเติมเกี่ยวกับ","ของเรา"]}get cbc4f32d(){return["รวมถึงสื่ออื่นๆ ที่ถูกทำเครื่องหมายว่าล่อแหลม เช่น สื่อจากบัญชีที่ทำเครื่องหมาย","ของตนว่าล่อแหลม"]}get a4fc317d(){return["บัญชีของคุณถูกตั้งค่าสถานะและไม่สามารถเข้าร่วมโปรแกรมส่วนแบ่งรายได้ของผู้สร้าง คุณสามารถอุทธรณ์ได้โดยทำตามคำแนะนำ"," ส่วนแบ่งรายได้ของคุณจะยังคงสะสมต่อไปในขณะที่คำอุทธรณ์ของคุณอยู่ระหว่างการดำเนินการ"]}get a8e78be7(){return["บัญชีของคุณถูกตั้งค่าสถานะและไม่สามารถเข้าร่วมโปรแกรมส่วนแบ่งรายได้จากโฆษณา คุณสามารถอุทธรณ์ได้โดยทำตามคำแนะนำ"," ส่วนแบ่งรายได้ของคุณจะยังคงสะสมต่อไปในขณะที่คำอุทธรณ์ของคุณอยู่ระหว่างการดำเนินการ"]}get g7970bc7(){return["สมัครสมาชิกเพื่อติดตาม",""+this.props.name]}get ede65a59(){return["สงสัยว่าคุณจะได้รับรายได้เท่าไรใช่ไหม "]}get a9c053c7(){return["การสมัครแสดงว่าคุณยอมรับ"]}get fdf28443(){return["การเลือกยอมรับและดำเนินการต่อแสดงว่าคุณยอมรับ"]}get f43d68d7(){return["ตรวจสอบราคาสำหรับระบบสมาชิกของคุณอีกครั้งและยืนยัน ","ขณะที่ระบบสมาชิกอยู่ในช่วงทดสอบ"]}get geee69df(){return["เลือกราคารายเดือนที่เหมาะสมกับคุณและกลุ่มเป้าหมายของคุณ สงสัยว่าคุณจะได้รับรายได้เท่าไหร่ใช่ไหม "]}get h406634b(){return["เราได้ยืนยันบัญชี Stripe ของคุณแล้ว ระบบสมาชิกในบัญชีของคุณจะใช้งานได้ในอีกไม่ช้า เราจะส่งการแจ้งเตือนถึงคุณทันทีที่ใช้งานได้ คุณยังสามารถเยี่ยมชมโปรไฟล์ของคุณเพื่อดูว่ามีการเปิดใช้งานระบบสมาชิกหรือไม่"]}get j2d920f7(){return['การเลื