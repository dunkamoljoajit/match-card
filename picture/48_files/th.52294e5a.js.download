2","ผลกระทบของการให้คะแนน"),c("a7b0393c","ผลกระทบของการเขียน"),c("id568acc","นักเขียนยอดนิยม"),c("e25f9ad6","การให้คะแนนที่ช่วยให้บันทึกได้รับสถานะว่าเป็นประโยชน์"),c("a0697fbc","ทำได้ดีมาก! การให้คะแนนเหล่านี้ระบุบันทึกที่เป็นประโยชน์ที่แสดงบริบทในโพสต์และช่วยให้ผู้คนได้รับข้อมูลข่าวสาร"),c("a3311a60","การให้คะแนนเหล่านี้ระบุบันทึกที่เป็นประโยชน์ที่แสดงบริบทในโพสต์และช่วยให้ผู้คนได้รับข้อมูลข่าวสาร"),c("bbc44f5a","การให้คะแนนเหล่านี้ระบุบันทึกที่เป็นประโยชน์ที่แสดงบริบทในโพสต์และช่วยให้ผู้คนได้รับข้อมูลข่าวสาร"),c("b4f21858","การให้คะแนนที่ช่วยให้บันทึกมีสถานะไม่เป็นประโยชน์"),c("d46b6bc8","การให้คะแนนเหล่านี้ช่วยปรับปรุงบันทึกของชุมชน โดยการให้คำติชมแก่ผู้เขียนบันทึก และช่วยให้ผู้ได้รับมอบหมายมุ่งความสนใจไปที่บันทึกที่มีแนวโน้มว่าจะเป็นประโยชน์มากที่สุด"),c("a5e6ba6a","การให้คะแนนบันทึกว่าเป็นประโยชน์ที่มีสถานะว่าไม่เป็นประโยชน์"),c("a22929e4","การให้คะแนนบันทึกว่าไม่เป็นประโยชน์ที่มีสถานะว่าเป็นประโยชน์"),c("b76dd726",'การให้คะแนนเหล่านี้เป็นเรื่องปกติและอาจนำไปสู่การเปลี่ยนแปลงสถานะได้หากมีผู้คนจำนวนมากพอที่เห็นด้วยว่าบันทึกที่มีสถานะ "เป็นประโยชน์" ไม่ได้มีประโยชน์มากเพียงพอ'),c("j29cc0f2","การให้คะแนนเหล่านี้จะถูกนับเป็นสองครั้งเนื่องจากมักบ่งชี้ถึงการสนับสนุนบันทึกที่ผู้อื่นเห็นว่ามีคุณภาพต่ำ"),c("cd4333d0","ไม่ต้องกังวลไป ใครๆ ก็ได้รับคะแนนเหล่านี้! "),c("e9fa53ac","การให้คะแนนบันทึกที่ยังไม่มีสถานะว่าเป็นประโยชน์หรือไม่เป็นประโยชน์ในขณะนี้"),c("fc664dee","การให้คะแนนบันทึกหลังจากได้รับสถานะแล้ว"),c("f024ec64","การให้คะแนนเหล่านี้สามารถเพิ่มคะแนนสถานะของบันทึกหรือช่วยเปลี่ยนแปลงสถานะได้"),c("e1ee08e6","ผลกระทบของการเขียน"),c("je3fc324","บันทึกของคุณที่ได้รับสถานะว่าเป็นประโยชน์"),c("f7358242","บันทึกที่ได้รับสถานะว่าเป็นประโยชน์"),c("j8e9b514","เยี่ยมมาก! ขณะนี้บันทึกเหล่านี้แสดงต่อทุกคนที่เห็นโพสต์ เพิ่มบริบทและช่วยให้ผู้คนรับทราบข้อมูลข่าวสาร"),c("e9e57c5c","ขณะนี้บันทึกเหล่านี้แสดงต่อทุกคนที่เห็นโพสต์ เพิ่มบริบทและช่วยให้ผู้คนรับทราบข้อมูลข่าวสาร"),c("fee0d8a8","บันทึกเหล่านี้จะแสดงบน X เพิ่มบริบทให้กับโพสต์และช่วยให้ผู้คนรับทราบข้อมูลข่าวสาร"),c("iab44364","บันทึกของคุณที่ได้รับสถานะว่าไม่เป็นประโยชน์"),c("d8c90438","บันทึกที่ได้รับสถานะว่าไม่เป็นประโยชน์"),c("accaa48e",`บันทึกเหล่านี้ได้รับการจัดอันดับว่าไม่มีประโยชน์ โดยผู้ได้รับมอบหมายที่มากเพียงพอ ซึ่งรวมถึงผู้ที่ไม่เห็นด้วยกับการให้คะแนนในอดีตในบางครั้ง คุณสามารถดูบันทึกเหล่านี้และข้อเสนอแนะที่ได้รับในข้อมูลส่วนตัวของคุณ
สถานะของบันทึกสามารถเปลี่ยนแปลงได้เมื่อมีผู้ให้คะแนนมากขึ้น`),c("fa2156f6",`บันทึกเหล่านี้ได้รับการจัดอันดับว่าไม่มีประโยชน์ โดยผู้ได้รับมอบหมายที่มากเพียงพอ ซึ่งรวมถึงผู้ที่ไม่เห็นด้วยกับการให้คะแนนในอดีตในบางครั้ง
สถานะของบันทึกสามารถเปลี่ยนแปลงได้เมื่อมีผู้ให้คะแนนมากขึ้น`),c("d004c768","บันทึกที่ต้องการคะแนนเพิ่มเติม"),c("f3d6d6c0","บันทึกที่ยังไม่ได้รับสถานะว่าเป็นประโยชน์หรือไม่เป็นประโยชน์"),c("d68a370c","อัพเดตล่าสุด: "),c("f10aaf3c","เคล็ดลับการประเมินโน้ต"),c("b9793c9a","คุณยังไม่ได้เขียนบันทึกใดๆ"),c("bed66f92","วิธีเริ่มต้นมีดังนี้:"),c("a3ca686a","ดูเคล็ดลับในการเขียนบันทึกที่เป็นประโยชน์"),c("ga8034c6","แตะเมนู ••• บนโพสต์ใดก็ได้เพื่อเขียนบันทึก"),c("h4109636","หากคุณคิดว่าโพสต์อาจทำให้เข้าใจผิด ให้เขียนข้อความที่เพิ่มบริบทที่เป็นประโยชน์ให้กับผู้ที่อาจพบเจอ"),c("ec30e9ac","ผู้ได้รับมอบหมายรายอื่นจะให้คะแนนความเป็นประโยชน์ของบันทึกของคุณ"),c("e0c42f80","หากบันทึกได้รับสถานะที่เป็นประโยชน์ บันทึกนั้นจะแสดงเป็นบริบทสำหรับทุกคนที่เห็นโพสต์"),c("ife4baaa","หมายเหตุจากชุมชนไม่ทำงานตามกฎส่วนใหญ่ ในการระบุบันทึกที่เป็นประโยชน์ต่อผู้คนในวงกว้าง จำเป็นต้องมีข้อตกลงเกี่ยวกับสถานะระหว่างผู้ได้รับมอบหมายที่บางครั้งไม่เห็นด้วยในการให้คะแนนที่ผ่านมา ซึ่งจะช่วยป้องกันการให้คะแนนแบบลำเอียง"),c("a0c552ee","ผลกระทบของคุณจะแสดงที่นี่"),c("a4e5ea3c","คุณยังไม่ได้ให้คะแนนบันทึกใดๆ"),c("g9a28bde","เรียกดูบันทึกที่ต้องการความช่วยเหลือ"),c("dc0046e2","เลือกดูหน้าแรกของหมายเหตุจากชุมชน"),c("fecae168","ซึ่งคุณจะพบบันทึกที่ต้องการคะแนนเพิ่มเติม และการให้คะแนนของคุณโดยเฉพาะสามารถช่วยได้"),c("h525e29e","ช่วยหาบันทึกที่อาจเป็นประโยชน์กับคนจำนวนมาก"),c("f6db7706","หมายเหตุจากชุมชนที่ดีที่สุดระบุการกล่าวอ้างของโพสต์โดยตรง เขียนด้วยภาษาที่เป็นประโยชน์และชัดเจน และเพิ่มแหล่งข้อมูลที่ผู้คนจำนวนมากมองว่าเชื่อถือได้"),c("f636b582","ช่วยหาบันทึกที่ไม่เป็นประโยชน์"),c("f58f4f62","การให้คะแนนบันทึกคุณภาพต่ำช่วยปรับปรุงหมายเหตุจากชุมชน โดยการให้ข้อเสนอแนะแก่ผู้เขียนบันทึก และช่วยให้ผู้ได้รับมอบหมายมุ่งความสนใจไปที่บันทึกที่มีแนวโน้มว่าจะเป็นประโยชน์มากที่สุด"),c("cf30af22","คุณรู้หรือไม่"),c("d145b0fa","สถานะบันทึกไม่ถึงตามกฎเสียงข้างมาก หากต้องการระบุบันทึกที่เป็นประโยชน์ต่อผู้คนในวงกว้าง สถานะของบันทึกจำเป็นต้องมีข้อตกลงระหว่างผู้ได้รับมอบหมายที่บางครั้งไม่เห็นด้วยในการให้คะแนนที่ผ่านมา ซึ่งจะช่วยป้องกันการให้คะแนนแบบลำเอียง"),c("c20a24cc","ยินดีด้วย!"),c("d01b8fc8","คุณเป็นนักเขียนหมายเหตุจากชุมชนยอดนิยม"),c("jbe2ad46",'นักเขียนที่มีผลกระทบของการเขียนสูงและมีบันทึกที่มีสถานะ "เป็นประโยชน์" ในสัดส่วนที่สูงสามารถเข้าถึง:'),c("d2dc3d4c","ให้ความสำคัญสำหรับการแจ้งเตือนเกี่ยวกับบันทึก"),c("heb73816","การเสนอบันทึกของนักเขียนยอดนิยมมีแนวโน้มที่จะกระตุ้นการแจ้งเตือนเพื่อให้ได้รับความสนใจจากผู้ให้คะแนน"),c("b760d51a","ป้ายกำกับในโปรไฟล์นามแฝง"),c("ief63e50","สามารถระบุนักเขียนยอดนิยมได้ด้วยป้ายกำกับในโปรไฟล์หมายเหตุจากชุมชน"),c("jd6b88ca","บันทึกเกี่ยวกับสื่อ"),c("c39bdf5a","นักเขียนยอดนิยมสามารถเขียนบันทึกเกี่ยวกับสื่อที่แสดงบนโพสต์หลายรายการ ซึ่งทำให้ผู้คนจำนวนมากได้รับข้อมูลที่ดีขึ้น"),c("d8361d0a","ข้อเสนอแนะเกี่ยวกับหมายเหตุที่ทำร่วมกัน"),c("jba34c04","ดูความคิดเห็น"),c("c393f116","นำข้อเสนอแนะไปปรับใช้แล้ว"),c("e5d18abe","ยังไม่ได้นำข้อเสนอแนะไปปรับใช้"),c("ac9c3858","ข้อเสนอแนะอยู่ระหว่างรอความคิดเห็น"),c("efb9a9e0","ไม่มีอะไรให้ดูที่นี่"),c("a1529ce7","เรียนรู้เพิ่มเติม"),c("f07ed596","ผู้ได้รับมอบหมายเช่นคุณร่วมกันช่วยระบุบันทึกที่เป็นประโยชน์เพื่อแสดงเป็นบริบทบน X และแจ้งให้ผู้คนทราบ"),c("h2b5268a","เยี่ยมมาก! ให้คะแนนบันทึกเพิ่มเติมเพื่อเพิ่มผลกระทบของคุณต่อไป"),c("e86c87a0","ให้คะแนนบันทึกเพิ่มเติม"),c("ad98f836","ผลกระทบจากการให้คะแนนของคุณเปลี่ยนเป็นเชิงลบ แต่ไม่ต้องกังวลนะ!"),c("e2d7c914","ให้คะแนนบันทึกต่อ"),c("a5427624","เลือกดูหน้าแรกของหมายเหตุจากชุมชนเพื่อค้นหาบันทึกที่ต้องการคะแนนจากผู้ได้รับมอบหมายมากขึ้น"),c("e227a7fa","สถานะบันทึกสามารถเปลี่ยนแปลงได้ตลอดเวลา"),c("eda73c9c","บางครั้งการให้คะแนนของคุณจะขัดแย้งกับสถานะในบันทึก แต่นั่นไม่ใช่ปัญหา! หากผู้ได้รับมอบหมายเห็นด้วยกับคุณมากขึ้น สถานะสามารถเปลี่ยนแปลงได้ และผลกระทบจะเปลี่ยนไป"),c("cfa3b664","ตอนนี้คุณสามารถเขียนบันทึกของชุมชนได้แล้ว!"),c("j44125ee","ผู้ร่วมให้ข้อมูลรายนี้ยังไม่ได้เขียนโน้ตใดๆ"),c("da55067c","ตรวจสอบพื้นที่สนทนานี้ในภายหลัง"),c("a123a58a","เรียนรู้เพิ่มเติมเกี่ยวกับข้อเสนอแนะ"),c("had43d26","ผู้ได้รับมอบหมายนี้ยังไม่ได้เขียนข้อเสนอแนะใดๆ"),c("ba17d826","เมื่อคุณปลดล็อกความสามารถในการเขียนบันทึกแล้ว คุณจะได้รับความสามารถในการเสนอแนะการปรับปรุงบันทึกเหล่านั้นด้วยเช่นกัน"),c("cbfd875c","ปลดล็อกความสามารถในการเสนอแนะการปรับปรุงบันทึก"),c("f5acb6f5",function(e){return"เมื่อคะแนนผลกระทบของการเขียนของคุณถึงระดับ "+e.cutoff+" หรือสูงกว่า คุณจะสามารถเสนอแนะการปรับปรุงในบันทึกต่างๆ ได้"}),c("f260c0ff",function(e){return"เมื่อคะแนนผลกระทบของการให้คะแนนของคุณถึงระดับ "+e.cutoff+" หรือสูงกว่า คุณจะสามารถเสนอแนะการปรับปรุงในหมายเหตุต่างๆ ได้"}),c("c27db2e8","คุณสามารถเสนอแนะการปรับปรุงในบันทึกได้"),c("f893c3b8","เข้าร่วมหมายเหตุจากชุมชน"),c("a701795c","ยังไม่มีหมายเหตุจากชุมชน"),c("db08295e","อยากเข้าร่วมใช่ไหม"),c("ha275800","ดูเหมือนว่าคุณจะไม่ได้เข้าร่วมโปรแกรมนำร่องหมายเหตุจากชุมชน เข้าร่วมตอนนี้เพื่อช่วยให้ผู้คนได้รับข้อมูลที่ดีขึ้น"),c("ce0a213a","หากต้องการสร้างบันทึก ให้เลือกไอคอนหมายเหตุจากชุมชนในเมนูของโพสต์ใดก็ได้ บันทึกที่คุณสร้างจะแสดงขึ้นที่นี่"),c("c87f3cf8","โน้ต"),c("a5b19492","ไม่มีโน้ตนี้"),c("c21d1b2a","โน้ตจะมีสถานะเป็นมีประโยชน์หรือไม่มีประโยชน์เมื่อมีข้อตกลงจากผู้ได้รับมอบหมายเพียงพอ ซึ่งรวมถึงผู้ที่ไม่เห็นด้วยในบางครั้งในการให้คะแนนที่ผ่านมา วิธีนี้ช่วยให้แน่ใจว่าโน้ตจะเป็นประโยชน์กับผู้คนจำนวนมาก และป้องกันการให้คะแนนแบบลำเอียง"),c("c7b59cde","การตั้งค่าของหมายเหตุจากชุมชน"),c("c20d0df5","ดูข้อมูลเพิ่มเติม"),c("a4293384","เวอร์ชันปัจจุบัน"),c("i5bc774a","เวอร์ชันก่อนหน้า"),c("cb491d96","ไม่มีประวัติการแก้ไขก่อนหน้า"),c("fb4ae7d0","กำลังโหลดประวัติการแก้ไข"),c("ae2c3e0a","ไม่มีประวัติการแก้ไขนี้"),c("d19ba24e","บันทึกนี้ไม่มีประวัติการแก้ไข"),c("a48a6d9a","ข้อเสนอแนะ"),c("j6407c18","ข้อเสนอแนะ"),c("c8e6202c","เวอร์ชันบันทึกต้นฉบับ"),c("jfed4e7c","เวอร์ชันบันทึกที่อัปเดตแล้ว"),c("ad544b60","กำลังโหลดข้อเสนอแนะ"),c("c1dbc84c","ไม่พบข้อเสนอแนะนี้"),c("g5f06d2a","ยังไม่มีข้อคิดเห็น"),c("d9752faa","ยังไม่ได้เผยแพร่"),c("abccc5b0","เหตุใดจึงนำไปปรับใช้"),c("c4f5ffcc","เหตุใดจึงไม่ได้นำไปปรับใช้"),c("if64e2aa","เหตุใดจึงมีการเผยแพร่"),c("i21e6d60","เหตุใดจึงไม่ได้รับการเผยแพร่"),c("a5a2330c","โพสต์กับสื่อเดียวกัน"),c("ad071b5c","โพสต