ะมีผลกับโพสต์ในอนาคตและจะไม่มีผลย้อนหลัง"),c("dbb51952","ป้องกันโพสต์ของคุณ"),c("de735de6","การดำเนินการนี้จะทำให้เฉพาะผู้ติดตามใน X ของคุณเท่านั้นที่มองเห็นข้อมูลนี้"),c("c5d4192a","ป้องกัน"),c("d9ddba70","ชุมชนเป็นแบบสาธารณะ ดังนั้นการป้องกันบัญชีของคุณจะเป็นการซ่อนโพสต์ก่อนหน้าของคุณ คุณจะไม่สามารถโพสต์ในชุมชนได้จนกว่าบัญชีของคุณจะเป็นแบบสาธารณะอีกครั้ง"),c("f527b322","ป้องกันบัญชีของฉัน"),c("d165c992","ทุกคนสามารถแท็กคุณได้"),c("ea339390","เฉพาะคนที่คุณติดตามเท่านั้นที่สามารถแท็กคุณได้"),c("e3a761ee","ปิด"),c("d3a2bde8","ดูข้อมูลเกี่ยวกับบัญชี ดาวน์โหลดเอกสารสำคัญสำหรับข้อมูล หรือเรียนรู้เกี่ยวกับตัวเลือกในการปิดการใช้งานบัญชี"),c("idca4742","ดูข้อมูลบัญชีของคุณได้เช่นเดียวกับหมายเลขโทรศัพท์และอีเมล"),c("b6ded35e","เปลี่ยนรหัสผ่านของคุณได้ทุกเมื่อ"),c("cce24bf4","รับข้อมูลเชิงลึกเกี่ยวกับประเภทข้อมูลที่จัดเก็บไว้ในบัญชีของคุณ"),c("i203df96","ค้นหาวิธีปิดการใช้งานบัญชีของคุณ"),c("a61ed23a","ทำเครื่องหมายว่าสื่อที่คุณโพสต์อาจมีเนื้อหาล่อแหลม"),c("ae27c454","เมื่อเปิดใช้งาน รูปภาพและวิดีโอที่คุณโพสต์จะถูกทำเครื่องหมายว่าล่อแหลมสำหรับผู้ที่ไม่ต้องการเห็นเนื้อหาที่ล่อแหลม"),c("fc1d217c","แสดงสื่อที่อาจมีเนื้อหาล่อแหลม"),c("j018f2a2","การตั้งค่าการสำรวจ"),c("h1ef00dc","การตั้งค่าการค้นหา"),c("ib3357a6","ปรับแต่งโฆษณาให้เป็นส่วนตัว"),c("f2f9628e","คุณจะเห็นโฆษณาบน X จากความเคลื่อนไหวบน X ของคุณเสมอ เมื่อเปิดใช้งานการตั้งค่านี้ X อาจปรับแต่งโฆษณาจากผู้โฆษณา X ทั้งในและนอก X โดยรวมความเคลื่อนไหวบน X ของคุณกับความเคลื่อนไหวทางออนไลน์อื่นๆ และข้อมูลจากคู่ค้าของเรา "),c("b5fe50fc","หมวดหมู่โฆษณา"),c("c31a2ea6","การเปิดใช้งานการตั้งค่าเหล่านี้ทำให้คุณมีสิทธิ์เห็นโฆษณาในหมวดหมู่เหล่านี้ เลือกเพื่อดูโฆษณาเกี่ยวกับหมวดหมู่เหล่านี้น้อยลงโดยเลือกไม่รับ"),c("if996630","การพนัน"),c("a9ed7774","อนุญาตให้ใช้เนื้อหาของ X ที่คุณเห็นในเว็บ"),c("e2d61838","การติดตั้งนี้จะทำให้ X สามารถติดตามการเข้าชมเว็บไซต์อื่นๆ ของคุณที่มีเนื้อหาของ X รวมอยู่ด้วย เช่น ลำดับเหตุการณ์ที่อยู่ในหน้านั้น ข้อมูลดังกล่าวทำให้คุณใช้ X ได้ดียิ่งขึ้น เช่นมีการปรับให้เหมาะกับการใช้งานของคุณโดยเฉพาะ และจะไม่มีการเก็บประวัติการเรียกดูเว็บนี้ที่มีชื่อ อีเมล หรือหมายเลขโทรศัพท์ของคุณ"),c("c966aaf4","ข้อมูลการเข้าเว็บเพจเหล่านี้จะไม่ถูกจัดเก็บหรือใช้เมื่อคุณอยู่ในบางประเทศ"),c("e8313b32","คุณแน่ใจหรือไม่ เมื่อคุณปิดแล้ว คุณจะไม่สามารถเปิดกลับได้อีกในระหว่างที่คุณอยู่ในประเทศนี้"),c("f1d46fd6","ใช่ ฉันแน่ใจ"),c("f6c8ccc8","ปรับแต่งให้เหมาะสมกับตัวตนของคุณ"),c("ed012c88","X จะทำการปรับแต่งประสบการณ์ของคุณตามข้อมูลที่คุณให้ไว้ รวมถึงอุปกรณ์ที่คุณใช้ในการเข้าสู่ระบบ เมื่อเปิดใช้งานการตั้งค่านี้ X อาจปรับแต่งตามความเหมาะสมของการอ้างอิงของคุณ เช่น อุปกรณ์และเบราว์เซอร์ของคุณที่ไม่ได้ใช้เพื่อเข้าสู่ระบบ X หรือที่อยู่อีเมลและหมายเลขโทรศัพท์ที่คล้ายกับที่ลิงก์กับบัญชี X ของคุณ"),c("d3c20d80","อนุญาตให้แบ่งปันข้อมูลเพิ่มเติมกับคู่ค้าทางธุรกิจ"),c("f1c0d09c","X แบ่งปันข้อมูลกับคู่ค้าทางธุรกิจอยู่เสมอเพื่อให้สามารถดำเนินงานและปรับปรุงผลิตภัณฑ์ให้ดีขึ้นได้ เมื่อเปิดใช้งาน การดำเนินการนี้จะทำให้ X สามารถแบ่งปันข้อมูลเพิ่มเติมกับคู่ค้าเหล่านั้นเพื่อช่วยสนับสนุนการดำเนินธุรกิจของ X ซึ่งรวมถึงการทำกิจกรรมด้านการตลาดของ X บนเว็บไซต์และแอพอื่นๆ ที่สอดคล้องกับคุณมากขึ้น"),c("dc20d918","ปรับแต่งให้เป็นส่วนตัวตามสถานที่ที่คุณเคยไป"),c("af7d89e6","X ใช้ประโยชน์จากข้อมูลบางอย่าง เช่น สถานที่ที่คุณสมัคร หรือตำแหน่งที่คุณอยู่ในปัจจุบัน เพื่อช่วยในการแสดงเนื้อหาที่เหมาะสมกับคุณมากขึ้น การเปิดการตั้งค่านี้ทำให้ X สามารถปรับเนื้อหาให้เหมาะกับคุณตามสถานที่อื่นๆ ที่คุณเคยไป"),c("f2b23062","การเข้าถึง การแสดงผล และภาษา"),c("fa76d7dc","จัดการวิธีแสดงเนื้อหาของ X ให้คุณเห็น"),c("j7a15010","จัดการการใช้งาน X ของคุณในด้านต่างๆ เช่น การจำกัดการตัดกันของสี และความเคลื่อนไหว"),c("a257ecae","จัดการขนาดตัวอักษร สี และพื้นหลัง การตั้งค่าเหล่านี้จะส่งผลต่อบัญชี X ทุกบัญชีบนเบราว์เซอร์นี้"),c("jc3fa0e2","จัดการการใช้ภาษาเพื่อปรับแต่งการใช้งาน X ให้เหมาะสมกับคุณ"),c("cc2973a8","จำกัดวิธีที่ X ใช้ข้อมูลเครือข่ายของคุณบางส่วนในอุปกรณ์นี้"),c("a4b69cbc","ภาษาที่แสดง"),c("c856bd00","เลือกภาษาที่คุณต้องการสำหรับพาดหัว ปุ่ม และข้อความอื่นๆ จาก X"),c("cab61d58","เลือกภาษาเพิ่มเติม"),c("dd93fafa","เลือกภาษาเพิ่มเติมสำหรับเนื้อหาที