นหมายเหตุพร้อมบริบทที่คุณเชื่อว่าควรแสดงในโพสต์ทั้งหมดพร้อมลิงก์เพื่อให้ผู้อื่นทราบ"),c("g3874520","เขียนบันทึกพร้อมบริบทที่คุณเชื่อว่าควรแสดงพร้อมกับโพสต์เพื่อให้ผู้อื่นทราบ"),c("ac1141aa","เขียนบันทึกเพื่อช่วยให้ผู้ได้รับมอบหมายของหมายเหตุจากชุมชนคนอื่นๆ เข้าใจว่าทำไมวิดีโอนี้จึงไม่ทำให้เข้าใจผิดหรือไม่ต้องการบริบทเพิ่มเติม"),c("f99ebcfc","เขียนบันทึกเพื่อช่วยให้ผู้ได้รับมอบหมายของหมายเหตุจากชุมชนคนอื่นๆ เข้าใจว่าทำไมรูปภาพนี้จึงไม่ทำให้เข้าใจผิดหรือไม่ต้องการบริบทเพิ่มเติม"),c("h641949e","เขียนบันทึกเพื่อช่วยให้ผู้ได้รับมอบหมายของหมายเหตุจากชุมชนคนอื่นๆ เข้าใจว่าทำไมโพสต์นี้จึงไม่ทำให้เข้าใจผิดหรือไม่ต้องการบริบทเพิ่มเติม"),c("c926cff6","จากหลักฐานในปัจจุบัน ฉันคิดว่าโพสต์นี้..."),c("e0ef7a2c","จากหลักฐานในปัจจุบัน ฉันคิดว่ารูปภาพนี้..."),c("g491d33a","จากหลักฐานในปัจจุบัน ฉันคิดว่าวิดีโอนี้..."),c("b253e462","จากหลักฐานในปัจจุบัน ฉันคิดว่าหน้าที่เชื่อมโยงนี้น่าจะ..."),c("b1b2d004","อาจทำให้เข้าใจผิดและควรจะมีบริบทเพิ่มเติม"),c("ha9655c2","ไม่ทำให้เข้าใจผิด"),c("ebd2de06","ทำไมคุณจึงคิดว่าโพสต์นี้อาจทำให้เกิดการเข้าใจผิด"),c("i865abe8","เหตุใดคุณจึงเชื่อว่ารูปภาพนี้อาจทำให้เข้าใจผิด"),c("add096c6","เหตุใดคุณจึงเชื่อว่าวิดีโอนี้อาจทำให้เข้าใจผิด"),c("eb604e2e","เหตุใดคุณจึงเชื่อว่าหน้าที่เชื่อมโยงอาจทำให้เกิดการเข้าใจผิด"),c("c33bc7d4","มีข้อมูลที่ผิดจากข้อเท็จจริง"),c("aadb676c","มีข้อมูลที่ไม่เป็นปัจจุบันซึ่งอาจทำให้เข้าใจผิด"),c("g21a0ef4","บิดเบือนความจริงหรือขาดบริบทที่สำคัญ"),c("daf354de","นำเสนอคำกล่าวอ้างในฐานะข้อเท็จจริง"),c("d1d2ef84","เป็นมุกตลกหรือเรื่องเสียดสีที่อาจถูกตีความผิดเป็นข้อเท็จจริง"),c("bfee6064","ทำไมคุณจึงคิดว่าโพสต์นี้ไม่ทำให้เกิดการเข้าใจผิด"),c("dfd1f7f0","เหตุใดคุณจึงเชื่อว่ารูปภาพนี้ไม่ได้ทำให้เข้าใจผิด"),c("b8623176","เหตุใดคุณจึงเชื่อว่าวิดีโอนี้ไม่ได้ทำให้เกิดการเข้าใจผิด"),c("ec66e3fc","เหตุใดคุณจึงเชื่อว่าหน้าที่เชื่อมโยงไม่ทำให้เกิดการเข้าใจผิด"),c("g228df26","แสดงถึงคำกล่าวอ้างที่ตรงกับข้อเท็จจริง"),c("h890a3f2","ถูกต้องในขณะที่แชร์ แต่ตอนนี้ข้อมูลไม่เป็นปัจจุบันแล้ว"),c("hf607a0a","ดูออกได้ชัดเจนว่าเป็นเรื่องเสียดสี/มุกตลก"),c("j6ac7742","แสดงความคิดเห็นส่วนบุคคล"),c("b1d82aae","คุณให้ลิงก์แหล่งที่มาที่คิดว่าผู้คนส่วนมากจะเชื่อถือแล้วใช่ไหม"),c("ae859ee0","บันทึกของคุณเกี่ยวกับโพสต์หรือรูปภาพหรือไม่"),c("ba84e7f8","บันทึกของคุณเกี่ยวกับโพสต์หรือวิดีโอหรือไม่"),c("ibb784c6","เกี่ยวกับโพสต์นี้โดยเฉพาะ"),c("a21ecb8c","เกี่ยวกับรูปภาพในโพสต์นี้ และควรปรากฏในโพสต์ทั้งหมดที่มีรูปภาพนี้"),c("he0ca8da","เกี่ยวกับวิดีโอในโพสต์นี้ และควรปรากฏในโพสต์ทั้งหมดที่มีวิดีโอนี้"),c("d0bf8d34","หมายเหตุของคุณเกี่ยวกับโพสต์หรือลิงก์"),c("db370b9a","หมายเหตุของคุณเกี่ยวกับโพสต์ รูปภาพ หรือลิงก์"),c("c35bf10e","หมายเหตุของคุณเกี่ยวกับโพสต์ วิดีโอ หรือลิงก์"),c("d96ce0d2","หมายเหตุนี้เขียนขึ้นในลักษณะที่จะเป็นประโยชน์กับโพสต์ทั้งหมดที่มีรูปภาพนี้"),c("a1fb516c","หมายเหตุนี้เขียนขึ้นในลักษณะที่จะเป็นประโยชน์กับโพสต์ทั้งหมดที่มีวิดีโอนี้"),c("be46a61e","หมายเหตุนี้เขียนขึ้นในลักษณะที่จะเป็นประโยชน์กับโพสต์ทั้งหมดที่มีสื่อนี้"),c("ied1c2c2","หมายเหตุนี้ค่อนข้างเฉพาะเจาะจงสำหรับโพสต์นี้และอาจไม่เกี่ยวข้องกับโพสต์อื่นๆ"),c("gb2433df",function(e){return""+e.noteMatchUrl}),c("gdfbdd93",function(e){return"ทั้ง "+e.matchCount+" โพสต์"}),c("d7959c4d",function(e){return"ทั้ง "+e.matchCount+" โพสต์"}),c("ff5be16d",function(e){return"ทั้ง "+e.matchCount+" โพสต์"}),c("abdd8d0a","แก้ไขโน้ต"),c("c097608e","โน้ตของคุณไม่มีคำอธิบาย"),c("ba25898c","โน้ตที่ลิงก์ไปยังแหล่งข้อมูลที่น่าเชื่อถือมีโอกาสที่จะได้รับการจัดอันดับว่าเป็นประโยชน์มากขึ้น"),c("e764d704","โน้ตที่ลิงก์ไปยังแหล่งข้อมูลที่น่าเชื่อถือมีโอกาสที่จะได้รับการจัดอันดับว่าเป็นประโยชน์มากขึ้น"),c("gb67e44c","ส่งโดยไม่มีคำอธิบาย"),c("d6b758a2","ส่งโดยไม่มีแหล่งข้อมูล"),c("dc1fa12c","บัญชีหมายเหตุจากชุมชนต้องมีหมายเลขโทรศัพท์ที่ยืนยันแล้ว"),c("a1752fde","หากต้องการมีส่วนร่วมในหมายเหตุจากชุมชนต่อไปจากบัญชีนี้ คุณจะต้องยืนยันหมายเลขโทรศัพท์ของคุณ"),c("hef02710","นอกเหนือจากการยืนยันแล้ว หมายเลขของคุณจะต้องมาจากผู้ให้บริการเครือข่ายโทรศัพท์ที่น่าเชื่อถือ และไม่เชื่อมโยงกับบัญชีหมายเหตุจากชุมชนอื่น"),c("dff9b6bc","ยืนยันโทรศัพท์มือถือของคุณ"),c("f051e434","ผู้ได้รับมอบหมายของหมายเหตุจากชุมชนต้องมีหมายเลขโทรศัพท์ที่ไม่ซ้ำกัน"),c("eaef2f72","ดูเหมือนว่ามีผู้ได้รับมอบหมายของหมายเหตุจากชุมชนหลายคนที่มีบัญชี X ที่เชื่อมโยงกับหมายเลขโทรศัพท์นี้"),c("j78d41b4","หากต้องการร่วมจัดการต่อจากบัญชีนี้ คุณจะต้องลบหมายเลขโทรศัพท์นี้ออกจากบัญชี X อื่น"),c("a7c9a176","บัญชีหมายเหตุจากชุมชนต้องมีหมายเลขโทรศัพท์ที่ยืนยันแล้วจากผู้ให้บริการที่น่าเชื่อถือ"),c("ec853dfa","หมายเลขโทรศัพท์ต้องมาจากผู้ให้บริการที่น่าเชื่อถือเพื่อลดการใช้หมายเลขโทรศัพท์เสมือนหรือที่ปลอมแปลงขึ้น"),c("j6e19c58","ค่านิยมของหมายเหตุจากชุมชน"),c("ea580ee2","เตือนความจำเกี่ยวกับค่านิยมของหมายเหตุจากชุมชน:"),c("eac7b6ac","ร่วมให้ข้อมูลเพื่อสร้างความเข้าใจ"),c("b0381cfc","มีความซื่อสัตย์สุจริต"),c("f0addddc","ยินดีช่วยเหลือผู้อื่น แม้กับคนที่ไม่เห็นด้วยกับคุณ"),c("h7c7b204","ช่วยให้คะแนนบันทึกที่มีอยู่ก่อนที่จะเขียนใหม่"),c("i8cae552","คุณจะช่วยรักษาคุณภาพในหมายเหตุจากชุมชนให้อยู่ในระดับสูงได้ด้วยการให้คะแนน"),c("hd43a218","คุณเขียนบันทึกถึงขีดจำกัดรายวันแล้ว"),c("aaba8ed2","มีการจำกัดจำนวนผู้ได้รับมอบหมายของบันทึกที่สามารถเขียนได้ในแต่ละวัน โดยขึ้นอยู่กับผลกระทบของการเขียนของพวกเขาเพื่อรักษาคุณภาพของบันทึกให้อยู่ในระดับสูงและป้องกันสแปม โปรดลองใหม่อีกครั้งในภายหลัง"),c("a67ed4d6","ในขณะนี้ คุณเพิ่มหมายเหตุในโพสต์ของผู้เขียนคนนี้ถึงขีดจำกัดแล้ว"),c("ic484166","เพื่อรักษาคุณภาพของหมายเหตุให้อยู่ในระดับสูงและป้องกันสแปม ระบบจึงจำกัดจำนวนหมายเหตุที่แต่ละคนสามารถเขียนเกี่ยวกับผู้เขียนโพสต์คนใดคนหนึ่งภายในช่วงเวลาหนึ่ง โดยขีดจำกัดนี้ขึ้นอยู่กับว่าผู้คนพบว่าหมายเหตุก่อนหน้ามีประโยชน์มากน้อยเพียงใด โปรดลองใหม่ภายหลัง"),c("b98f077c","ขอข้อมูลบันทึก"),c("ee691104","ขอหมายเหตุจากชุมชนเกี่ยวกับโพสต์นี้"),c("j825663a","ขณะนี้มีหมายเหตุที่ทำร่วมกันที่ได้รับการเสนอปรากฏขึ้นบนโพสต์แล้ว"),c("f8cbdf02","คิดว่าโพสต์นี้อาจทำให้เข้าใจผิดใช่ไหม ขอหมายเหตุจากชุมชน"),c("a9c58d34","คุณสามารถช่วยให้คะแนนและปรับปรุง"),c("f132d1be","ผู้ได้รับมอบหมายจะเห็นการแจ้งเตือนในโพสต์ที่ได้รับคำขอเพียงพอ"),c("gf71296c","หากบันทึกถูกเขียนและให้คะแนนว่าเป็นประโยชน์โดยผู้มีส่วนร่วมรายอื่น บันทึกนั้นจะปรากฏในโพสต์"),c("de0685b4","X ไม่ได้เลือกว่าจะแสดงบันทึกใด – หมายเหตุจากชุมชนจัดทำโดยผู้คน เพื่อผู้คน"),c("f8ac3c88","ยอมรับและขอบันทึก"),c("b4917374","ดำเนินการขอหมายเหตุต่อไป"),c("je9cfe26","ดูหมายเหตุที่ทำร่วมกัน"),c("a8edd0ea","ต้องการเพิ่มแหล่งที่มาหรือไม่"),c("a39a0de6","ลิงก์ไปยังโพสต์ X"),c("j819c176","ช่วยผู้ได้รับมอบหมายของหมายเหตุจากชุมชนโดยใส่ลิงก์ไปยังโพสต์ X ที่อธิบายสิ่งที่อาจทำให้เข้าใจผิด"),c("e15b3b44","ลิงก์จะต้องไปที่โพสต์ X ตัวอย่าง: x.com/user/status/...."),c("i0be4994","อธิบายหรือไม่"),c("cefb034e","คำอธิบาย"),c("d2f9157a","ช่วยผู้สนับสนุนของหมายเหตุจากชุมชนด้วยการอธิบายเพิ่มเติมเกี่ยวกับสิ่งที่อาจทำให้เกิดความเข้าใจผิด"),c("c81085a4","หมายเหตุจากชุมชน"),c("c363515c","เปิดเผยต่อสาธารณะ"),c("cb6b0138","ขอบคุณ! คำขอของคุณถูกส่งไปแล้ว"),c("f47dcb4c","ขอบคุณ! ขณะนี้มีหมายเหตุที่ทำร่วมกันที่ได้รับการเสนอปรากฏขึ้นบนโพสต์แล้ว"),c("c196e8b8","หากมีการเขียนบันทึกและให้คะแนนว่าเป็นประโยชน์ คุณจะเห็นบันทึกนั้นในโพสต์"),c("a9491efa","ส่งคำขอหมายเหตุจากชุมชนแล้ว"),c("f060d1cc","ลบคำขอ"),c("f499f824","ลบคำขอของคุณ"),c("hd1bc518","อาจใช้เวลาสักครู่ก่อนที่คุณจะสามารถส่งคำขอใหม่ในโพสต์นี้ได้"),c("geb8d31d","สมัครเลย"),c("gc399930","ข้อมูลคำขอหมายเหตุขีดจำกัดรายวัน"),c("fee815e4","คุณขอหมายเหตุถึงขีดจำกัดรายวันแล้ว"),c("i7eb7900","ขีดจำกัดรายวันของคุณจะเพิ่มขึ้นหากคุณส่งคำขอในโพสต์ที่ได้รับหมายเหตุซึ่งเป็นประโยชน์ได้สำเร็จ"),c("d1a3817e","สิ่งนี้จะเป็นรางวัลให้กับผู้ที่ค้นหาโพสต์ที่อาจก่อให้เกิดความเข้าใจผิดที่ควรมีบริบทเพิ่มเติมได้สำเร็จ"),c("c031c77a","ขีดจำกัดรายวันของคุณอาจลดลงหากคุณส่งคำขอมากเกินไปในโพสต์ที่ผู้คนไม่เห็นด้วยและต้องการหมายเหตุ"),c("f87129d2","สิ่งนี้จะช่วยป้องกันสแปมและทำให้ผู้เขียนหมายเหตุมุ่งความสนใจไปยังโพสต์ที่ควรมีหมายเหตุที่เป็นประโยชน์"),c("jdd4a572","บัญชีของคุณต้องมีหมายเลขโทรศัพท์ที่ยืนยันแล้ว"),c("i0f07c07","ยืนยันโทรศัพท์ของคุณ"),c("i157c1a8","คำขอนี้ถูกลบแล้ว"),c("a9f4ca9c","ผู้ได้รับมอบหมายของหมายเหตุจากชุมชนสามารถดูบันทึกของคุณได้แล้ว"),c("eb8f7c0c","ผู้ได้รับมอบหมายสามารถให้คะแนนบันทึกของคุณได้แล้ว"),c("h87c6bd6","ผู้ได้รับมอบหมายรายอื่นสามารถดูบันทึกของคุณได้แล้ว"),c("gc1a5bce","พวกเขาจะประเมินความเป็นประโยชน์"),c("i0e950ca","หากบันทึกของคุณได้รับสถานะว่าเป็นประโยชน์ บันทึกจะเริ่มแสดงเป็นบริบทสำหรับทุกคนที่เห็นโพสต์นั้น"),c("a047e800","บันทึกของคุณช่วยให้ผู้ได้รับมอบหมายคนอื่นๆ มีบริบทมากขึ้นเมื่อให้คะแนนบันทึก"),c("cec8a38c","หากบันทึกของคุณได้รับสถานะว่าเป็นประโยชน์ คุณจะได้รับผลกระทบของการเขียน"),c("a377532e","หากผู้คนที่มีมุมมองแตกต่างกันประเมินว่าบันทึกเป็นประโยชน์มากพอ บันทึกจะแสดงเป็นบริบทสำหรับทุกคนที่เห็นโพสต์"),c("d790fa4e","สถานะของบันทึกไม่ได้ถูกกำหนดโดยกฎเสียงข้างมาก"),c("e90cda68","หากต้องการระบุบันทึกที่เป็นประโยชน์ต่อผู้คนในวงกว้าง สถานะของบันทึกจำเป็นต้องมีข้อตกลงระหว่างผู้ได้รับมอบหมายที่ไม่เห็นด้วยกับการให้คะแนนในอดีตในบางครั้ง"),c("j5a1d85a","ดูโน้ตของคุณ"),c("b25b64d6","โน้ตของคุณถูกส่งแล้ว"),c("g1428d70","ส่งบันทึกของคุณแล้ว!"),c("a4ec7004","นี่คือสิ่งที่เกิดขึ้นในตอนนี้"),c("c4093274","เกี่ยวกับหมายเหตุจากชุมชนหลังจากส่ง"),c("bc8746a6","โปรดให้คะแนนอย่างน้อยหนึ่งบันทึกก่อนที่จะเขียนบันทึกใหม่"),c("ce3c80b8","หมายเหตุจากชุมชนขึ้นอยู่กับการให้คะแนนของคุณเพื่อรักษาคุณภาพให้อยู่ในระดับสูง"),c("fa6a075a","บันทึกที่แนะนำบริบทที่จะแสดงพร้อมกับโพสต์"),c("acb7ecae","บันทึกที่อธิบายเหตุผลว่าเหตุใดจึงไม่ต้องการบริบทเพิ่มเติม"),c("d9a5fc06","ให้คะแนนโพสต์"),c("b73cebd2","ให้คะแนนโพสต์และบันทึก"),c("ad8883f2","ไม่มีบันทึกในโพสต์นี้"),c("c7814e04","ไม่มีบันทึกที่บ่งบอกถึงบริบท"),c("efd14e7a","กำลังโหลดโน้ต"),c("cc5d6270","ผู้ได้รับมอบหมายได้เสนอหมายเหตุจากชุมชนเกี่ยวกับโพสต์นี้"),c("bcc14a68",'หมายเหตุจากชุมชนเป็นโปรแกรมที่ผู้ได้รับมอบหมายอาสาเข้ามาเพื่อเพิ่มบริบท (เรียกว่า "บันทึก") ให้กับโพสต์ที่พวกเขาเชื่อว่าอาจทำให้เข้าใจผิด โดยผู้ได้รับมอบหมายสามารถประเมินบันทึกด้านล่างได้ และหากบันทึกเหล่านี้ได้รับการประเมินว่าเป็นประโยชน์ในขณะนี้ บันทึกจะแสดงเป็นบริบทในโพสต์ หากบันทึกได้รับการประเมินว่าเป็นประโยชน์ในขณะนี้ แต่คุณไม่เห็นด้วย คุณสามารถร้องขอการตรวจสอบเพิ่มเติมได้ ซึ่งหมายความว่าจะมีผู้ได้รับมอบหมายจำนวนมากขึ้นที่ร่วมตรวจสอบบันทึก และคะแนนของบันทึกอาจมีการเปลี่ยนแปลง '),c("c21313ba","ขณะนี้โน้ตได้รับการประเมินว่าไม่เป็นประโยชน์"),c("c2c40120","แสดงโน้ตทั้งหมด"),c("ia596d40","เห็นอะไรที่คุณต้องการปรับปรุงหรือไม่"),c("deff0bde","เขียนโน้ต"),c("i8e85ef8","เข้าร่วมหมายเหตุจากชุมชนและเข้าถึงการเขียนบันทึกและคุณสมบัติอื่นๆ เพื่อช่วยสร้างการรับรู้ข้อมูลที่ดีขึ้นของโลกใบนี้"),c("af88892a","บันทึกเหล่านี้ถูกเพิ่มโดยผู้ได้รับมอบหมายของหมายเหตุจากชุมชน ซึ่งเชื่อว่าโพสต์นี้อาจทำให้เข้าใจผิด และจะได้รับประโยชน์จากบริบทเพิ่มเติม"),c("cf8a40a6","จะสามารถมองเห็นบันทึกได้เฉพาะในหมายเหตุจากชุมชน จนกว่าจะได้รับการประเมินว่าเป็นประโยชน์โดยผู้ได้รับมอบหมายที่มากเพียงพอ"),c("g22c8c30","หากบันทึกเหล่านี้ได้รับการประเมินว่าเป็นประโยชน์โดยผู้ได้รับมอบหมายที่มากเพียงพอ ซึ่งรวมถึงผู้ที่มักไม่เห็นด้วยกับการให้คะแนนในอดีต บันทึกเหล่านั้นจะเริ่มแสดงต่อสาธารณะพร้อมกับโพสต์โดยเป็นบริบทเพิ่มเติม"),c("jf04b084","บันทึกเหล่านี้ถูกเพิ่มโดยผู้ได้รับมอบหมายที่เชื่อว่าโพสต์นี้ไม่ได้ทำให้เข้าใจผิดและไม่ต้องการบริบทเพิ่มเติม"),c("g5a72e98","สิ่งเหล่านี้จะมองเห็นได้เฉพาะในหมายเหตุจากชุมชน โดยเป็นข้อมูลเพิ่มเติมสำหรับผู้ให้คะแนน และจะไม่แสดงเป็นบริบทของโพสต์ แม้ว่าจะได้รับสถานะว่าเป็นประโยชน์ก็ตาม"),c("b8719c22","ช่วยระบุว่าผู้คนจากมุมมองที่หลากหลายมากดชื่นชอบโพสต์หรือไม่"),c("jcdf97d4","คุณชอบอะไรเกี่ยวกับโพสต์นี้"),c("d4d7b67e","คุณไม่ชอบอะไรเกี่ยวกับโพสต์นี้"),c("ed5156fa","มีข้อผิดพลาดในการบันทึกการประเมินของคุณ โปรดลองอีกครั้ง"),c("d0ed3636","คุณให้คะแนนโพสต์นี้"),c("j6aa6172","ลบการประเมิน"),c("i4112750","การดำเนินการนี้ย้อนกลับไม่ได้"),c("i6f6191a","ขอบคุณ!"),c("h5575012","ยอมรับและส่ง"),c("f9171e52","โพสต์นี้ได้รับการกดชื่นชอบจากผู้คนที่ปกติมักไม่เห็นด้วย แต่ข้อมูลที่มีตอนนี้ยังค่อนข้างจำกัด"),c("j0f9919a","การให้คะแนนของคุณจะไม่ส่งผลเสียต่อโพสต์ แต่สามารถช่วยให้โพสต์ที่ได้รับการกดชื่นชอบอย่างกว้างขวางได้รับการยอมรับในทางบวก"),c("b3af830c","ข้อมูลของคุณ:"),c("d0b29562","ให้คะแนนโพสต์เพิ่มเติมตอนนี้"),c("i36ea87a","ฉันเห็นด้วยกับโพสต์"),c("d5befc34","ฉันได้เรียนรู้สิ่งที่น่าสนใจ"),c("je26ecf2","สื่อสารประเด็นที่มีความหมาย"),c("e4e331aa","ช่วยให้เกิดความเป็นหนึ่งเดียวในเรื่องที่มักก่อให้เกิดการ