อนดำเนินการตามคำขอของคุณ"),c("fbc023b0","ใช่"),c("e785ce06","ฉันจะใช้ตัวเลือกอื่น"),c("i8d58f3e","ฉันจะใช้บัตรประจำตัวที่ออกโดยภาครัฐ"),c("eb21ecaa","ฉันจะใช้ที่อยู่อีเมล"),c("f848a69e","เราจำเป็นต้องยืนยันว่าบัญชีของคุณเป็นของแท้เพื่อยืนยันตัวตนของคุณ หากชื่อเรียกของคุณไม่มีการอ้างอิงในเว็บไซต์อย่างเป็นทางการ เราไม่สามารถยืนยันความถูกต้องของบัญชีได้"),c("d59b5366","เราจำเป็นต้องยืนยันว่าบัญชีของคุณเป็นของจริงเพื่อยืนยันตัวตนของคุณ หากไม่มีการอ้างอิงชื่อเรียกของคุณบนหน้าที่คุณระบุลิงก์ไว้ เราจะไม่สามารถไว้วางใจที่จะเชื่อมโยงบัญชีของคุณกับผู้สร้างเนื้อหาที่มีชื่อเสียงได้"),c("bfb01c62","ไม่ ย้อนกลับ"),c("fa51040a","ระบุลิงก์ไปยังเว็บไซต์ทางการขององค์กรหรือสิ่งพิมพ์ด้านข่าวสารที่มีคุณสมบัติเหมาะสมซึ่งสามารถใช้อ้างอิงคุณและบัญชี X ของคุณ"),c("d0460f12","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการสำหรับองค์กรของคุณ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("h45b00d8","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยบริษัทด้านความบันเทิงที่เกี่ยวข้องกับคำขอนี้"),c("fc718708","เว็บไซต์ทางการขององค์กรที่มีคุณสมบัติเหมาะสมซึ่งสามารถใช้อ้างอิงถึงคุณและบัญชี X ของคุณ"),c("g32c2900","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยองค์กรด้านการผลิตที่เกี่ยวข้องกับคำขอนี้"),c("j5b1224c","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการสำหรับการผลิตของคุณ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("d090a5d4","เว็บไซต์ทางการขององค์กรหรือสำนักพิมพ์ที่ได้รับการยืนยันแล้วซึ่งสามารถใช้อ้างอิงบัญชี X ของคุณ"),c("eb08a392","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยผู้สมัครรับการเลือกตั้งสำหรับตำแหน่งทางภาครัฐที่เกี่ยวข้องกับคำขอนี้"),c("h0de1396","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการของผู้สมัครเข้ารับตำแหน่งที่เกี่ยวข้องกับคำขอนี้ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("dcc23262","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยนักเคลื่อนไหวหรือผู้จัดงานที่เกี่ยวข้องกับคำขอนี้"),c("c880e068","เว็บไซต์ทางการขององค์กรสนับสนุนซึ่งสามารถใช้อ้างอิงคุณและบัญชี X ของคุณ"),c("e412d500","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าคุณเป็นผู้นำในองค์กรสนับสนุนที่ได้รับการยืนยันแล้วและบัญชี X ของคุณ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการขององค์กรที่ยืนยันแล้ว"),c("dedf41f2","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยผู้มีอิทธิพลทางความคิดที่เกี่ยวข้องกับคำขอนี้"),c("b4aed9e0","เว็บไซต์ทางการขององค์กรที่ได้รับการยืนยันซึ่งสามารถใช้อ้างอิงคุณและบัญชี X ของคุณ"),c("b2069e40","ระบุลิงก์ที่สามารถใช้อ้างอิงคุณและบัญชี X ของคุณ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการขององค์กรที่ยืนยันแล้ว"),c("baf718c4","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยบริษัท แบรนด์ หรือองค์กรที่เกี่ยวข้องกับคำขอนี้"),c("c65bbbc2","Select a method to show that your account is authentic and managed by the senior leader or executive related to this request."),c("i31e3606","ที่อยู่อีเมลทางการที่มีโดเมนของบริษัท แบรนด์ หรือองค์กรที่มีคุณสมบัติเหมาะสม"),c("de70afe8","การอ้างอิงถึงคุณและบัญชี X ของคุณบนเว็บไซต์อย่างเป็นทางการขององค์กรที่มีคุณสมบัติเหมาะสม"),c("a3a523f2","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการสำหรับบริษัทของคุณ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("jf58899a","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าคุณเป็นผู้นำระดับสูงในองค์กรและบัญชี X ของคุณ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("f7afbaec","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยนักข่าวสำหรับองค์กรข่าวหรือสิ่งพิมพ์ที่มีคุณสมบัติเหมาะสม"),c("d4ab0056","เลือกวิธีการเพื่อแสดงว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยนักข่าวฟรีแลนซ์ที่มีชื่อเสียง"),c("d2a77622","ที่อยู่อีเมลทางการที่มีโดเมนขององค์กรข่าวหรือสิ่งพิมพ์ที่มีคุณสมบัติเหมาะสม"),c("eec341da","เว็บไซต์ทางการขององค์กรหรือสิ่งพิมพ์ด้านข่าวสารซึ่งสามารถใช้อ้างอิงบัญชี X ของคุณ"),c("b03ae068","เลือกวิธียืนยันว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยองค์กรข่าวหรือสิ่งพิมพ์ที่เกี่ยวข้องกับคำขอนี้"),c("g0daba4a","เลือกหนึ่งวิธีเพื่อแสดงว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยบุคคลในวงการเกมอาชีพที่เกี่ยวข้องกับคำขอนี้"),c("ab8e430c","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการของบุคคลในวงการเกมที่เกี่ยวข้องกับคำขอนี้ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("cdcd9cd6","เลือกหนึ่งวิธีเพื่อแสดงว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยบุคคลในหน่วยงานด้านกีฬาอาชีพที่เกี่ยวข้องกับคำขอนี้"),c("gad25890","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการของหน่วยงานกีฬาอาชีพที่เกี่ยวข้องกับคำขอนี้ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("e6dc91b2","เลือกหนึ่งวิธีเพื่อแสดงว่าบัญชีของคุณเป็นของจริงและได้รับการจัดการโดยบุคคลในวงการกีฬาอาชีพที่เกี่ยวข้องกับคำขอนี้"),c("i9aed706","ระบุลิงก์ที่สามารถใช้อ้างอิงได้ว่าบัญชีของคุณเป็นบัญชี X ทางการของนักกีฬาอาชีพที่เกี่ยวข้องกับคำขอนี้ โดยข้อมูลอ้างอิงต้องมาจากเว็บไซต์ทางการของนิติบุคคลที่ตรวจสอบแล้ว"),c("abd587d2","เพิ่มข้อมูลอ้างอิงอื่น"),c("i0bba81a","เพิ่มข้อมูลอ้างอิงของการจ้างงาน"),c("a6a76e3c","เลือกวิธีการยืนยันความมีชื่อเสียง"),c("ecd2abda","ยืนยันสิทธิ์ของบัญชี"),c("cb70b894","ย้อนกลับ"),c("g8b511fe","Google Trends"),c("c7d50c96","ข้อมูลส่วนตัวบน Google Trends พร้อมหลักฐานกิจกรรมการค้นหาล่าสุดเกี่ยวกับคุณ"),c("a68b43ee","เพิ่มข้อมูลส่วนตัวบน Google Trends"),c("b5e30390","Google Trends profile"),c("h146703e","บทความ Wikipedia"),c("ee38d0f0","บทความ Wikipedia ที่เกี่ยวกับคุณและเป็นไปตามมาตรฐานความมีชื่อเสียงสำหรับผู้คน"),c("cb97ee3e","เพิ่มบทความ Wikipedia"),c("hc371f34","การทำข่าว"),c("b9d0ad90","ลิงก์อย่างน้อยสามลิงก์จากองค์กรข่าวที่มีชื่อเสียงซึ่งทำข่าวหรืออ้างอิงถึงคุณภายในหกเดือนที่ผ่านมา"),c("ge137dce","บทความเกี่ยวกับคุณอย่างน้อยสามบทความจากสำนักข่าวที่มีคุณสมบัติในช่วงหกเดือนที่ผ่านมา"),c("h2b9a5fe","At least three articles about your company from qualifying news publications in the last six months."),c("baccb708","เพิ่มการนำเสนอข่าวที่ได้รับการยืนยัน"),c("feadd98c","Add verified news references"),c("j7ae97aa","Verified news references"),c("c368aa8e","At least three articles from verified news publications that reference you."),c("ded0edad",function(e){return"บทความ #"+e.n}),c("bebae55a","ตลาดหุ้นสาธารณะ"),c("c5571610","ลิงก์ที่แสดงหลักฐานการแสดงตัวที่สำคัญในตลาดหุ้นสาธารณะ"),c("e2d42628","เพิ่มการอ้างอิงตลาดหุ้น"),c("jc19b4e8","การจดทะเบียนในตลาดหุ้น"),c("fc3ee696","Leadership reference"),c("i3e65eb4","The official site of a verified organization that references you in a leadership position."),c("jd014eba","The URL provided links to the specific page referencing applicant."),c("a96901cc","เพิ่มการอ้างอิงความเป็นผู้นำ"),c("cc424a22","การอ้างอิงการสนับสนุน"),c("ibfc1a5a","คุณไม่มีสิทธิ์รับการยืนยันในหมวดหมู่นี้"),c("e1c78796","เว็บไซต์อย่างเป็นทางการ"),c("ff2ee0c2","การเคลื่อนไหว"),c("hc61adfc","ความบันเทิง"),c("e404203c","การเล่นเกม"),c("d27beb9e","กีฬา"),c("cc4b66b6","เลือกหมวดหมู่"),c("b37461a4","เลือกประเภทบัญชี"),c("b27325f6","ผู้สร้างเนื้อหา"),c("a5a6affc","ผู้สร้างเนื้อหาดิจิทัลที่มีอิทธิพลซึ่งเผยแพร่เนื้อหาที่สร้างขึ้นเองที่น่าสนใจอย่างสม่ำเสมอ"),c("a15326de","มีอย่างน้อยสามบทความจากสำนักข่าวที่มีคุณสมบัติซึ่งสามารถใช้อ้างอิงถึงคุณได้"),c("g704a93a","เว็บไซต์ทางการที่เกี่ยวข้องกับงานสนับสนุนที่เป็นที่รู้จักซึ่งอ้างอิงถึงคุณในตำแหน่งผู้นำ"),c("c6bd60ec","นักเคลื่อนไหวหรือผู้จัดงาน"),c("c92fdb06","ผู้มีชื่อเสียงที่ใช้ X เพื่อสร้างการเปลี่ยนแปลงทางเศรษฐกิจสังคม การเมือง และวัฒนธรรม"),c("a18c6dfc","นักข่าว"),c("h0b46534","นักข่าวที่ได้รับการว่าจ้างโดยองค์กรหรือสิ่งพิมพ์ด้านข่าวสารที่มีคุณสมบัติเหมาะสม"),c("ff929fec","Prominent organization or affiliate"),c("jf537894","Prominent organizations, and secondary affiliated accounts, including companies, brands, and non-profit organizations."),c("d2ea204a","ผู้มีอิทธิพลทางความคิดอื่นๆ"),c("f875ec6e","บุคคลที่มีสถานะสำคัญทั้งในและนอกแพลตฟอร์ม X ซึ่งไม่จัดอยู่ในหมวดหมู่อื่น"),c("i3e6aaa6","Senior leader or executive"),c("bbcbb9e6","Leaders and other prominent executives of notable companies, brands, and non-profit organizations."),c("j0bc23f4","I have confirmed